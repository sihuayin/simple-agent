# 权限策略示例：复制为 .rules 使用（JSON 数组，追加在内置默认规则之后）
# 内置默认：Deny（rm -rf /、dd、curl|bash…）> Ask（git push --force、rm -r、write/edit_file）> Allow（npm run、git 查看、读文件…）
# 同类型规则中默认规则先命中；未命中任何规则则兜底 Ask。
# bash 的 pattern 匹配命令串（* 含斜杠）；文件工具用工具级规则；受保护路径独立生效（.env*、.git/** 等）。
[
  { "tool": "bash", "pattern": "cargo *", "action": "allow" },
  { "tool": "bash", "pattern": "pnpm *", "action": "allow" },
  { "tool": "bash", "pattern": "git push*", "action": "ask" },
  { "tool": "bash", "pattern": "kill *", "action": "ask" }
]
