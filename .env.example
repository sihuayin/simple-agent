# Copy to .env and fill in. The CLI reads these from the environment (or .env).
# Provider selection: --provider flag > LLM_PROVIDER > default deepseek.
LLM_PROVIDER=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
